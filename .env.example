# Variables locales — este archivo NO se sube al repositorio
# Copia aquí los valores desde Supabase: Home → Connect → Astro (paso 2)

PUBLIC_RECAPTCHA_SITE_KEY=

# reCAPTCHA v3 — clave secreta (solo servidor, nunca PUBLIC_)
RECAPTCHA_SECRET_KEY=

# HubSpot
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=

# Modo prueba: devuelve success sin enviar a HubSpot ni verificar captcha
PUBLIC_CONTACT_TEST_MODE=true

PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase — intermediario de datos (server-only) ──────────────────────────
# Clave service_role: las tablas de contenido tienen RLS y solo este rol puede
# leerlas. NUNCA usar el prefijo PUBLIC_ (no debe llegar al navegador).
# Obtener en: Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Bucket de Supabase Storage para imágenes (opcional, default: storage_partners)
SUPABASE_STORAGE_BUCKET=

