---
import type { ImageMetadata } from "astro";
import Breadcrumb from "../../Breadcrumb.astro";
import HybridImage from "../../HybridImage.astro";
import { images } from "../../../assets/images";

const { breadcrumbItems, developments } = Astro.props;

// El ícono puede venir como URL remota (`developmentIconUrl`, Supabase) o como
// key de asset local (`developmentSrc`, legacy). La remota tiene prioridad.
function resolveIcon(item: any): ImageMetadata | string | null {
    if (item.developmentIconUrl) return item.developmentIconUrl;
    if (item.developmentSrc && item.developmentSrc in images) {
        return images[item.developmentSrc as keyof typeof images];
    }
    return null;
}

function buildLink(item: any): string {
    const dest = item.developmentDestination;
    const link = item.developmentLink;
    switch (item.developmentCategory) {
        case "branded-residences":
            return `/${dest}/branded-residences/${item.developmentGroup}/${link}`;
        case "high-end-resort":
            return `/${dest}/high-end-and-resort-living/${link}`;
        case "commercial-projects":
            return `/${dest}/commercial-projects/${link}`;
        default:
            return `/${dest}/${link}`;
    }
}
---
<section class="mb-16 md:mb-[124px] min-h-[calc(80vh-88px)]">
    <div class="container">
        <div class="pt-6 pb-5">
            <Breadcrumb items={breadcrumbItems} />
        </div>
        <div class="articles">
            {developments && developments.length > 0 ? (
                    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
                        {developments.map((item: any) => {
                            const icon = resolveIcon(item);

                            if (!icon) {
                                console.error("Ícono no encontrado para desarrollo:", item.developmentId ?? item.developmentLink);
                                return null;
                            }

                            return (
                                    <div class="w-full min-w-[161.5px] md:min-w-[217px] h-[190px] grid place-items-center border border-gray-200 rounded-xl overflow-hidden">
                                        <a
                                                href={buildLink(item)}
                                                class={`grid place-items-center w-full h-full ${item.developmentHasPadding ? "p-10" : ""}`}
                                        >
                                            <HybridImage
                                                    class="max-w-full max-h-full object-contain"
                                                    src={icon}
                                                    alt={item.developmentAlt}
                                            />
                                        </a>
                                    </div>
                            );
                        })}
                    </div>
            ) : (
                    <div class="flex justify-center min-h-[40vh]">
                        <h1 class="text-2xl font-semibold text-center">
                            No hay información de desarrollos disponibles
                        </h1>
                    </div>
            )}
        </div>

    </div>
</section>
