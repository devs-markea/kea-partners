            padding-left: 16px;
            padding-right: 16px;
            margin-bottom: 0;
        }

    }
    .destinations {
        padding: 16px;
        position: relative;
    }

    /* Nav buttons */
    .destinations-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        width: 40px;
        height: 40px;
        border-radius: 9999px;
        background-color: white;
        border: none;
        box-shadow: 0 1px 4px rgba(0,0,0,0.12);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        opacity: 0.6;
        color: #053F47;
        transition: opacity 0.2s, background-color 0.2s, color 0.2s;
        user-select: none;
    }

    @media (min-width: 768px) {
        .destinations-nav {
            width: 48px;
            height: 48px;
        }
        .destinations-nav svg {
