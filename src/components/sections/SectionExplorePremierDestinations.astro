    }
    .swiper-pagination-destinations .swiper-pagination-bullet-active {
        width: 24px;
        height: 8px;
        background: var(--secondary-900);
        opacity: 1;
        border-radius: 12px;
        transition: all 0.3s ease;
    }
    .swiper-pagination-destinations .swiper-pagination-bullet,
    .swiper-pagination-destinations .swiper-pagination-bullet-active {
        transition: all 0.4s cubic-bezier(0.77, 0, 0.175, 1);
    }

    .hero__bullets{
        position: absolute;
        display: flex;
        align-items: baseline;
        color: white;
        flex-direction: row;
        top: unset;
        left: 50%;
        bottom: 40px;
        transform: translateX(-50%);
        z-index: 1;
    }
    .hero__bullets .numeric-indicator__nav {
        display: flex;
