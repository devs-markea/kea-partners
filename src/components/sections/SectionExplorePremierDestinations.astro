---
import type { ImageMetadata } from "astro";
import TopDestinationCard from "../TopDestinationCard.astro";


const { t, lang, destinations: provided } = Astro.props;

const basePath = lang === "en" ? "/en" : "";
const withLang = (path: string) => `${basePath}/${path}`;

const localImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/images/destinations/*.webp",
    { eager: true }
);

/** Item unificado que renderiza el carrusel — viene del JSON legacy o del
 *  merge híbrido (legacy + overlay de Supabase). */
interface CarouselItem {
    title:          string;
    url:            string;
    description:    string | null;
    alt:            string;
    /** Imagen remota ya resuelta (card_image_key con fallback a banner_key). */
    imageUrl:       string | null;
    legacyImgName:  string | null;
}

// Compatibilidad legacy: si no recibimos un array `destinations` ya mergeado
// (overlay con la API), derivamos los items del JSON local como se venía
// haciendo. Cuando llegan mergeados, el overlay ya se aplicó campo a campo.
const items: CarouselItem[] = provided ?? t.highlights_destinations.map((d: any) => ({
    title:         d.destination_title,
    url:           d.destination_url,
    description:   d.destination_description,
    alt:           d.destination_title,
    imageUrl:      null,
    legacyImgName: d.destination_img,
}));

// La API gana sobre el asset local cuando trae `imageUrl`; si no, se busca
// el asset en la carpeta `destinations/`. Devolver `null` deja el item fuera.
function resolveSrc(item: CarouselItem): ImageMetadata | string | null {
    if (item.imageUrl) return item.imageUrl;
    if (item.legacyImgName) {
        const path = `/src/assets/images/destinations/${item.legacyImgName}.webp`;
        return localImages[path]?.default ?? null;
    }
    return null;
}

// Se resuelve la imagen en el frontmatter para descartar los items sin asset:
// así el ocultamiento de la sección (regla 1) refleja los items realmente
// renderizables, no solo la longitud del array de entrada.
const renderable = items
    .map((item) => ({ item, src: resolveSrc(item) }))
    .filter((entry): entry is { item: CarouselItem; src: ImageMetadata | string } => {
        if (!entry.src) {
            console.error("Imagen no encontrada para destino:", entry.item.title);
            return false;
        }
        return true;
    })
    .sort((a, b) =>
        a.item.title.localeCompare(b.item.title, undefined, {
            sensitivity: "base",
            numeric: true,
        }),
    );
---

{renderable.length > 0 && (
<section class="section-highlights pt-11 md:pt-16">
    <div class="highlights container mx-auto px-5 md:px-8">

        <div class="flex justify-center">
            <div class="w-full">

                <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-12 ">
                    <h2 class="title">
                        {t.highlights_title}
                    </h2>

                    <div class="subtitle mt-2 md:mt-0">
                        {t.highlights_subtitle}
                    </div>
                </div>

                <!-- Content -->
                <div class="destinations">
                    <div class="destinations-nav destinations-btn-prev" aria-label="Anterior">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6"/>
                        </svg>
                    </div>
                    <div class="destinations-nav destinations-btn-next" aria-label="Siguiente">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"/>
                        </svg>
                    </div>
                    <div class="swiper">
                        <div class="swiper-wrapper">
                            {renderable.map(({ item, src }, index) => (
                                <div class="swiper-slide w-auto">
                                    <TopDestinationCard
                                            src={src}
                                            alt={item.alt}
                                            title={item.title}
                                            subtitle={item.description ?? ""}
                                            url={withLang(item.url)}
                                            priority={index === 0}
                                    />
                                </div>
                            ))}
                        </div>

                        <div class="swiper-pagination-destinations mt-8 flex justify-center"></div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</section>
)}

<script>
    import Swiper from 'swiper';
    import { Navigation, Pagination, Autoplay } from 'swiper/modules';
    import 'swiper/css';
    import 'swiper/css/pagination';
    import 'swiper/css/navigation';

    function swiperDestinations() {
        const el = document.querySelector('.destinations .swiper');
        if (!el) return;

        new Swiper(el, {
            modules: [Navigation, Pagination, Autoplay],

            slidesPerView: 1,
            spaceBetween: 20,
            centerInsufficientSlides: true,

            breakpoints: {
                320: { slidesPerView: 1, spaceBetween: 15 },
                768: { slidesPerView: 2, spaceBetween: 20 },
                1024: { slidesPerView: 3, spaceBetween: 30 }
            },

            pagination: {
                el: '.swiper-pagination-destinations',
                clickable: true,
                type: 'bullets'
            },

            navigation: {
                prevEl: '.destinations-btn-prev',
                nextEl: '.destinations-btn-next',
            },
            grabCursor: true,
            speed: 500,

            keyboard: {
                enabled: true,
                onlyInViewport: true
            },

            mousewheel: {
                forceToAxis: true
            },

            on: {
                init() {
                    this.el.classList.add('swiper-loaded');
                },
                slideChange() {
                    document.dispatchEvent(
                        new CustomEvent('swiperSlideChange', {
                            detail: {
                                activeIndex: this.activeIndex,
                                slides: this.slides.length
                            }
                        })
                    );
                }
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', swiperDestinations);
    } else {
        swiperDestinations();
    }
</script>

<style is:global>
    /* Styles Swiper*/
    .swiper-pagination-destinations{
        display: flex;
        justify-content: center;
        margin-top: 32px;
    }
    .swiper-pagination-destinations .swiper-pagination-bullet {
