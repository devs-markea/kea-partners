        margin: 0 32px 32px 32px;
        background-color: rgba(255, 255, 255, 0.95);
        border-radius: 4px;
        padding: 14px;
        z-index: 1;
    }


    .highlights .destinations .top-destination .content .float-card .heading {
        margin-bottom: 6px;
    }

    .highlights .destinations .top-destination .content .heading h3 {
        font-family: var(--font-secondary), sans-serif;
        font-size: 20px;
        font-style: normal;
        font-weight: 500;
    }

    .highlights .destinations .top-destination .content .paragraph p {
