    /* Mobile: tarjeta visible */
    .highlights .destinations .top-destination .content .float-card {
        transform: translateY(0);
    }

    /* Desktop */
    @media (min-width: 768px) {

        .highlights .destinations .top-destination .content .float-card {
            transform: translateY(48px);
            transition: transform 0.3s ease;
        }

        .highlights .destinations .top-destination:hover .float-card {
            transform: translateY(-32px);
        }

        .highlights .destinations .top-destination .content .float-card {
            margin: 0 32px 02px 32px;
        }


    }
    .title {
        font-family: 'Cormorant Garamond', serif;
        width: 20%;
        font-weight: 500;
        font-size: 32px;
        line-height: 1;
        letter-spacing: 0;
