            height: 24px;
        }
    }

    .destinations-nav:hover {
        opacity: 1;
        background-color: var(--secondary-900);
        color: white;
    }

    .destinations-btn-prev {
        left: -12px;
    }

    .destinations-btn-next {
        right: -12px;
    }

    .destinations-nav.swiper-button-disabled {
        opacity: 0.25;
        pointer-events: none;
    }

    @media (max-width: 767px) {
        .destinations-btn-prev {
            left: 4px;
        }
        .destinations-btn-next {
            right: 4px;
        }
    }
</style>