---
import { Image } from "astro:assets";
import teamData from "../../data/i18n/es/team.json";

const { team } = teamData;

const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/images/broken/*.webp",
    { eager: true }
);
---

<section class="team-section py-16 md:py-24">
    <div class="container mx-auto px-5">

        <!-- ── Header ── -->
        <div class="team-header flex flex-col items-center text-center mb-8">
            <span class="text-brand-400 font-jost text-xs font-medium uppercase tracking-[0.2em] block mb-4">
                {team.label}
            </span>
            <h2 class="text-brand-400 font-aghato font-medium leading-tight mb-4" style="font-size: clamp(28px, 4vw, 42px); white-space: pre-line;">
                {team.title}
            </h2>
            <p class="text-brand-700 font-jost font-light opacity-75 leading-relaxed max-w-md">
                {team.description}
            </p>
        </div>

        <!-- ── Nav Buttons ── -->
        <div class="team-nav flex items-center justify-center gap-3 mb-8">
            <button class="team-btn-prev flex items-center justify-center w-10 h-10 rounded-full bg-white border border-gray-200 shadow-sm text-brand-400 hover:bg-brand-400 hover:text-white hover:border-brand-400 transition-all duration-200 disabled:opacity-30">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
            </button>
            <button class="team-btn-next flex items-center justify-center w-10 h-10 rounded-full bg-white border border-gray-200 shadow-sm text-brand-400 hover:bg-brand-400 hover:text-white hover:border-brand-400 transition-all duration-200 disabled:opacity-30">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
            </button>
        </div>

        <!-- ── Carousel ── -->
        <div class="team-carousel overflow-hidden">
            <div class="swiper">
                <div class="swiper-wrapper">
                    {team.members.map((member) => {
                        const imagePath = `/src/assets/images/broken/${member.image}.webp`;
                        const imageModule = images[imagePath];
                        const imageSrc = imageModule?.default;

                        return (
                            <div class="swiper-slide team-slide">
                                <article class="team-card bg-white border border-gray-100 shadow-sm flex flex-col">

                                    <!-- Container 1: Photo + Name + Role -->
                                    <div class="team-card__top flex flex-col items-center">
                                        <!-- Rounded image -->
                                        <div class="team-card__img-wrap">
                                            {imageSrc ? (
                                                <Image
                                                    src={imageSrc}
                                                    alt={member.name}
                                                    class="team-card__img"
                                                />
                                            ) : (
                                                <div class="team-card__img-placeholder"></div>
                                            )}
                                        </div>
                                        <h3 class="text-brand-400 font-aghato font-medium text-[17px] leading-tight text-center">
                                            {member.name}
                                        </h3>
                                        <p class="text-brand-300 font-jost text-[11px] font-medium uppercase tracking-widest text-center">
                                            {member.role}
                                        </p>
                                    </div>

                                    <!-- Container 2: Stats + Divider + Buttons -->
                                    <div class="team-card__bottom flex flex-col">

                                        <!-- Two stats side by side -->
                                        <div class="flex justify-around">
                                            <div class="flex flex-col items-center gap-0.5">
                                                <span class="text-brand-600 font-jost text-[10px] font-normal uppercase tracking-wider">
                                                    Especialidad
                                                </span>
                                                <span class="text-brand-400 font-jost text-[12px] font-medium text-center leading-tight">
                                                    {member.specialty}
                                                </span>
                                            </div>
                                            <div class="w-px bg-gray-100 self-stretch mx-2"></div>
                                            <div class="flex flex-col items-center gap-0.5">
                                                <span class="text-brand-600 font-jost text-[10px] font-normal uppercase tracking-wider">
                                                    Zona
                                                </span>
                                                <span class="text-brand-400 font-jost text-[12px] font-medium text-center leading-tight">
                                                    {member.zone}
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Divider -->
                                        <div class="h-px bg-gray-100"></div>

                                        <!-- Two action buttons -->
                                        <div class="flex gap-3">
                                            <a
                                                href={`mailto:${member.emailRaw}`}
                                                class="team-card__btn flex-1 flex items-center justify-center gap-2 rounded-full border border-brand-400 text-brand-400 font-jost text-[12px] font-medium py-2 px-3 hover:bg-brand-400 hover:text-white transition-colors duration-200"
                                            >
                                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <rect width="20" height="16" x="2" y="4" rx="2"/>
                                                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                                                </svg>
                                                Email
                                            </a>
                                            <a
                                                href={`https://wa.me/${member.phoneRaw}`}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="team-card__btn flex-1 flex items-center justify-center gap-2 rounded-full bg-brand-400 text-white font-jost text-[12px] font-medium py-2 px-3 hover:opacity-90 transition-opacity duration-200"
                                            >
                                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                                                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
                                                </svg>
                                                WhatsApp
                                            </a>
                                        </div>

                                    </div>
                                </article>
                            </div>
                        );
                    })}
                </div>
            </div>
        </div>

        <!-- ── Pagination ── -->
        <div class="swiper-pagination-team mt-8 flex justify-center"></div>

    </div>
</section>

<script>
    import { initTeamSwiper } from '../../scripts/swipers.js';

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTeamSwiper);
    } else {
        initTeamSwiper();
    }
</script>

<style is:global>
/* ── Section ── */
.team-section {
    background-color: #F1F2F2;
}

/* ── Slide fixed width ── */
.team-slide {
    width: 308px !important;
    flex-shrink: 0;
}

/* ── Card ── */
.team-card {
    width: 308px;
    height: 352px;
    border-radius: 24px;
    overflow: hidden;
    padding: 20px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.team-card__top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
}

.team-card__bottom {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

/* ── Photo ── */
.team-card__img-wrap {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    overflow: hidden;
    background-color: #E6DDD4;
    border: 3px solid #053F47;
    margin-bottom: 4px;
}

.team-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
}

.team-card__img-placeholder {
    width: 100%;
    height: 100%;
    background-color: #E6DDD4;
}

/* ── Pagination ── */
.swiper-pagination-team {
    display: flex;
    justify-content: center;
    margin-top: 32px;
}

.swiper-pagination-team .swiper-pagination-bullet {
    width: 8px;
    height: 8px;
    background: #A9AAAA;
    opacity: 0.8;
    border-radius: 50%;
    margin: 0 6px !important;
    transition: all 0.4s cubic-bezier(0.77, 0, 0.175, 1);
}

.swiper-pagination-team .swiper-pagination-bullet-active {
    width: 24px;
    height: 8px;
    background: #053F47;
    opacity: 1;
    border-radius: 12px;
}
</style>
