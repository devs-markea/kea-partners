---
import { Image } from "astro:assets";
import teamData from "../../data/i18n/es/team.json";

const { team } = teamData;

const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/images/broken/*.webp",
    { eager: true }
);
---

<section class="team-section py-16 md:py-24">
    <div class="container mx-auto px-5">

        <!-- ── Header ── -->
        <div class="team-header flex flex-col items-center text-center mb-8">
            <span class="text-[#C6A664] font-jost text-xs font-medium uppercase tracking-[0.2em] block mb-4">
                {team.label}
            </span>
            <h2 class="text-brand-400 font-aghato font-medium mb-4" style="font-size: clamp(28px, 4vw, 42px); white-space: pre-line; line-height: 1.1;">
                {team.title}
            </h2>
            <p class="text-brand-700 font-jost font-light opacity-75 leading-relaxed max-w-2xl">
                {team.description}
            </p>
        </div>

        <!-- ── Nav Buttons ── -->
        <div class="team-nav flex items-center justify-center gap-3 mb-8">
            <button class="team-btn-prev flex items-center justify-center w-10 h-10 rounded-full bg-white border border-gray-200 shadow-sm text-brand-400 hover:bg-brand-400 hover:text-white hover:border-brand-400 transition-all duration-200 disabled:opacity-30">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
            </button>
            <button class="team-btn-next flex items-center justify-center w-10 h-10 rounded-full bg-white border border-gray-200 shadow-sm text-brand-400 hover:bg-brand-400 hover:text-white hover:border-brand-400 transition-all duration-200 disabled:opacity-30">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
            </button>
        </div>

        <!-- ── Carousel ── -->
        <div class="team-carousel overflow-hidden mx-auto team-carousel-wrap">
            <div class="swiper">
                <div class="swiper-wrapper">
                    {team.members.map((member) => {
                        const imagePath = `/src/assets/images/broken/${member.image}.webp`;
                        const imageModule = images[imagePath];
                        const imageSrc = imageModule?.default;

                        return (
                            <div class="swiper-slide team-slide">
                                <article class="team-card bg-white border border-gray-100 shadow-sm flex flex-col">

                                    <!-- Container 1: Photo + Name + Role -->
                                    <div class="team-card__top">
                                        <div class="team-card__img-wrap">
                                            {imageSrc ? (
                                                <Image
                                                    src={imageSrc}
                                                    alt={member.name}
                                                    class="team-card__img"
                                                />
                                            ) : (
                                                <div class="team-card__img-placeholder"></div>
                                            )}
                                        </div>
                                        <h3 class="team-card__name">{member.name}</h3>
                                        <p class="team-card__role">{member.role}</p>
                                    </div>

                                    <!-- Container 2: Stats + Divider + Buttons -->
                                    <div class="team-card__bottom">

                                        <!-- Stats row -->
                                        {(member.properties || member.experience) && (
                                            <div class={`team-card__stats ${(!member.properties || !member.experience) ? 'team-card__stats--single' : ''}`}>
                                                {member.properties && (
                                                    <>
                                                        <div class="team-card__stat">
                                                            <span class="team-card__stat-value">{member.properties}</span>
                                                            <span class="team-card__stat-label">Propiedades</span>
                                                        </div>
                                                        {member.experience && <div class="team-card__stat-divider"></div>}
                                                    </>
                                                )}
                                                {member.experience && (
                                                    <div class="team-card__stat">
                                                        <span class="team-card__stat-value">{member.experience}</span>
                                                        <span class="team-card__stat-label">Experiencia</span>
                                                    </div>
                                                )}
                                            </div>
                                        )}

                                        <!-- Divider -->
                                        <div class="team-card__divider"></div>

                                        <!-- Buttons -->
                                        <div class="team-card__actions">
                                            <a href={`mailto:${member.emailRaw}`} class="team-card__btn team-card__btn--outline">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <rect width="20" height="16" x="2" y="4" rx="2"/>
                                                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                                                </svg>
                                                Email
                                            </a>
                                            <a href={`https://wa.me/${member.phoneRaw}`} target="_blank" rel="noopener noreferrer" class="team-card__btn team-card__btn--filled">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                                                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
                                                </svg>
                                                WhatsApp
                                            </a>
                                        </div>

                                    </div>
                                </article>
                            </div>
                        );
                    })}
                </div>
            </div>
        </div>

        <!-- ── Pagination ── -->
        <div class="swiper-pagination-team mt-8 flex justify-center"></div>

    </div>
</section>

<script>
    import { initTeamSwiper } from '../../scripts/swipers.js';

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTeamSwiper);
    } else {
        initTeamSwiper();
    }
</script>

<style is:global>
/* ── Section ── */
.team-section {
    background-color: #F1F2F2;
}

/* ── Carousel container ── */
.team-carousel-wrap {
    max-width: 100%;
}

@media (min-width: 1024px) {
    .team-carousel-wrap {
        max-width: 972px; /* 308×3 + 24×2 */
    }

    .team-slide {
        width: 308px !important;
    }

    .team-card {
        width: 308px;
    }
}

/* ── Slide ── */
.team-slide {
    flex-shrink: 0;
}

/* ── Card ── */
.team-card {
    width: 100%;
    height: auto;
    min-height: 350px;
    border-radius: 24px;
    overflow: hidden;
    padding: 20px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
}

/* ── Container 1: Photo + Name + Role ── */
.team-card__top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
}

/* ── Photo ── */
.team-card__img-wrap {
    width: 140px;
    height: 140px;
    border-radius: 9999px;
    overflow: hidden;
    background-color: #E6DDD4;
    margin-bottom: 6px;
    flex-shrink: 0;
}

.team-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
}

.team-card__img-placeholder {
    width: 100%;
    height: 100%;
    background-color: #E6DDD4;
}

/* Name */
.team-card__name {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    font-size: 20px;
    line-height: 28px;
    letter-spacing: 0;
    text-align: center;
    color: #3D3D3D;
    margin: 0;
}

/* Role */
.team-card__role {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    text-align: center;
    color: #C6A664;
    margin: 0;
}

/* ── Container 2: Stats + Divider + Buttons ── */
.team-card__bottom {
    display: flex;
    flex-direction: column;
    gap: 0;
}

/* Stats row */
.team-card__stats {
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding-bottom: 20px;
}

.team-card__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    flex: 1;
}

.team-card__stat-value {
    font-family: 'Cormorant Infant', serif;
    font-weight: 400;
    font-size: 24px;
    line-height: 24px;
    text-align: center;
    color: #053F47;
    margin-bottom: 10px;
}

.team-card__stat-label {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 12px;
    line-height: 16px;
    text-align: center;
    color: #6B7E7D;
}

.team-card__stat-divider {
    width: 1px;
    height: 36px;
    background-color: #F3F4F6;
    flex-shrink: 0;
    margin: 0 8px;
}

.team-card__stats--single {
    justify-content: center;
}

/* Divider line */
.team-card__divider {
    border-bottom: 1px solid #F3F4F6;
    margin-bottom: 10px;
}

/* Buttons */
.team-card__actions {
    display: flex;
    gap: 12px;
    height: 45px;
}

.team-card__btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border-radius: 9999px;
    font-family: 'Jost', sans-serif;
    font-weight: 500;
    font-size: 12px;
    cursor: pointer;
    transition: opacity 0.2s, background-color 0.2s, color 0.2s;
    text-decoration: none;
}

.team-card__btn--outline {
    border: 2px solid #053F47;
    color: #053F47;
    background: transparent;
}

.team-card__btn--outline:hover {
    background-color: #053F47;
    color: #fff;
}

.team-card__btn--filled {
    background-color: #053F47;
    color: #fff;
    border: 2px solid #053F47;
}

.team-card__btn--filled:hover {
    opacity: 0.85;
}

/* ── Pagination ── */
.swiper-pagination-team {
    display: flex;
    justify-content: center;
    margin-top: 32px;
}

.swiper-pagination-team .swiper-pagination-bullet {
    width: 8px;
    height: 8px;
    background: #A9AAAA;
    opacity: 0.8;
    border-radius: 50%;
    margin: 0 6px !important;
    transition: all 0.4s cubic-bezier(0.77, 0, 0.175, 1);
}

.swiper-pagination-team .swiper-pagination-bullet-active {
    width: 24px;
    height: 8px;
    background: var(--secondary-900);
    opacity: 1;
    border-radius: 12px;
}
</style>
