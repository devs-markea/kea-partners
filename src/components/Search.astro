---
import SvgIcon from "./SvgIcon.astro";

---
<!-- Search -->
<div class="search mb-4">
    <form id="search-form">
        <label for="default-search-main" class="text-sm font-medium text-gray-900 sr-only dark:text-gray-300">Search</label>
        <div class="relative">
            <input type="search" name="q" id="default-search-main" autocomplete="off" class="block p-4 pr-14 truncate w-full text-base text-brand-500 bg-gray-50 rounded-3xl border border-gray-300 focus-visible:outline-none" placeholder="Buscar por desarrollo, recurso o palabra clave..." required/>
            <button type="submit" class="flex absolute inset-y-0 right-0 items-center pr-3 text-white " aria-label="Search submit button">
                <span class="w-10 h-10 bg-[#CFAB76] rounded-full flex items-center justify-center">
                    <SvgIcon iconKey="SearchTopicsIcon" width={34} height={34}/>
                </span>
            </button>
            <ul id="suggestions-main" class="absolute left-0 right-0 mt-1 bg-white border rounded shadow hidden max-h-60 overflow-y-auto z-10"></ul>
        </div>
    </form>
</div>


<script>
    // El buscador en vivo ya NO consulta datos en el cliente: la búsqueda
    // (legacy + Supabase reconciliado) corre en el servidor vía /api/search.

    const formSearch = document.getElementById("search-form");
    const input = document.getElementById("default-search-main");
    const suggestions = document.getElementById("suggestions-main");

    const params = new URLSearchParams(window.location.search);
    const queryParam = params.get("q");

    // Escapa texto antes de inyectarlo en innerHTML (el contenido ahora viene
    // del CRM/API, editable por usuarios → evita XSS).
    const escapeHtml = (value) =>
        String(value ?? "").replace(/[&<>"']/g, (c) => ({
            "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
        })[c]);

    // Manejar el submit del formulario
    formSearch.addEventListener("submit", (e) => {
        e.preventDefault();
        const query = input.value.trim();
        if (query) {
            window.location.href = `/search?q=${encodeURIComponent(query)}`;
        }
    });

    function renderSuggestions(results) {
        suggestions.innerHTML = results.length
            ? results.map((item) => `
      <li class="text-left">
        <a href="${escapeHtml(item.slug)}" class="block px-4 py-2 hover:bg-gray-100 text-left" target="_blank">
          <span class="text-xs uppercase text-gray-500">${escapeHtml(item.type)}</span><br>
          <strong>${escapeHtml(item.title)}</strong>
          <p class="text-sm text-gray-600">${escapeHtml(item.description)}</p>
        </a>
      </li>
    `).join("")
            : `<li class="p-2 text-gray-500 text-left">No se encontraron resultados</li>`;
        suggestions.classList.remove("hidden");
    }

    // Contador de secuencia: descarta respuestas que lleguen fuera de orden.
    let requestSeq = 0;
    let debounceTimer;

    async function fetchSuggestions(query) {
        const seq = ++requestSeq;
        try {
            const res = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const data = await res.json();
            if (seq !== requestSeq) return; // llegó una búsqueda más nueva
            renderSuggestions(data.results ?? []);
        } catch (error) {
            if (seq !== requestSeq) return;
            console.error("[Search] Error al buscar sugerencias:", error);
            suggestions.innerHTML =
                `<li class="p-2 text-gray-500 text-left">No se pudo buscar. Intenta de nuevo.</li>`;
            suggestions.classList.remove("hidden");
        }
    }

    input.addEventListener("input", () => {
        const query = input.value.trim();
        clearTimeout(debounceTimer);

        if (!query) {
            requestSeq++; // invalida respuestas en vuelo
            suggestions.innerHTML = "";
            suggestions.classList.add("hidden");
            return;
        }

        debounceTimer = setTimeout(() => fetchSuggestions(query), 250);
    });

    input.addEventListener("blur", () => {
        setTimeout(() => suggestions.classList.add("hidden"), 150);
    });

    // Si existe, asignarlo al input
    if (queryParam) {
        input.value = queryParam;
    }

</script>