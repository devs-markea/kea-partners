---
import '../styles/global.css';
import { images } from '../assets/images';
import { Image } from 'astro:assets';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <title>Nueva contraseña — Kea Partners</title>
</head>
<body class="min-h-screen bg-brand-50 font-jost flex">

    <!-- LEFT PANEL — Brand -->
    <div class="hidden lg:flex lg:w-1/2 bg-brand-400 relative flex-col justify-between p-12 overflow-hidden">

        <!-- Decorative background elements -->
        <div class="absolute inset-0 opacity-5">
            <div class="absolute top-0 right-0 w-[600px] h-[600px] border border-brand-300 rounded-full translate-x-1/2 -translate-y-1/2"></div>
            <div class="absolute bottom-0 left-0 w-[400px] h-[400px] border border-brand-300 rounded-full -translate-x-1/2 translate-y-1/2"></div>
        </div>
        <div class="absolute bottom-24 right-0 w-[1px] h-48 bg-brand-300 opacity-30"></div>
        <div class="absolute top-1/3 left-12 w-24 h-[1px] bg-brand-300 opacity-20"></div>

        <!-- Logo -->
        <div class="relative z-10 flex items-center gap-4">
            <Image
                src={images.Logo}
                alt="Kea Partners"
                class="w-[90px] h-auto"
                quality={90}
                loading="eager"
            />
            <span class="text-brand-50 text-sm font-medium tracking-[0.15em] uppercase opacity-90">
                Kea Partners
            </span>
        </div>

        <!-- Center content -->
        <div class="relative z-10 flex-1 flex flex-col justify-center max-w-sm">
            <div class="w-8 h-[1px] bg-brand-300 mb-6"></div>
            <h1 class="font-cormorant text-brand-50 text-5xl font-light leading-tight mb-4">
                Un nuevo<br />
                <em class="text-brand-300 not-italic">comienzo</em><br />
                para tu cuenta.
            </h1>
            <p class="text-brand-50 text-sm font-light opacity-60 leading-relaxed">
                Elige una contraseña segura para proteger<br />
                el acceso a tu cuenta en Kea Partners.
            </p>
        </div>

        <!-- Bottom tagline -->
        <div class="relative z-10">
            <p class="text-brand-50 text-xs opacity-30 tracking-[0.2em] uppercase">
                Luxury Real Estate · México
            </p>
        </div>

        <!-- Golden accent line -->
        <div class="absolute left-0 top-0 bottom-0 w-[3px] bg-gradient-to-b from-transparent via-brand-300 to-transparent opacity-40"></div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="flex-1 flex flex-col justify-center items-center px-6 py-12 lg:py-0">

        <!-- Mobile logo -->
        <div class="flex lg:hidden items-center gap-3 mb-10">
            <Image
                src={images.Logo}
                alt="Kea Partners"
                class="w-[72px] h-auto"
                quality={90}
                loading="eager"
            />
            <span class="text-brand-400 text-sm font-medium tracking-[0.15em] uppercase">
                Kea Partners
            </span>
        </div>

        <div class="w-full max-w-[400px]">

            <!-- STATE: Invalid / expired token -->
            <div id="stateInvalid" class="hidden text-center">
                <div class="flex items-center justify-center w-16 h-16 rounded-full bg-red-50 mx-auto mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                    </svg>
                </div>
                <p class="text-red-400 text-xs font-medium tracking-[0.2em] uppercase mb-2">Enlace inválido</p>
                <h2 class="font-cormorant text-brand-400 text-4xl font-light mb-3">
                    El enlace expiró
                </h2>
                <p class="text-brand-500 text-sm font-light leading-relaxed mb-8">
                    Este enlace de recuperación ya no es válido o ha expirado.<br />
                    Solicita uno nuevo desde la pantalla de inicio de sesión.
                </p>
                <a
                    href="/forgot-password"
                    class="w-full flex items-center justify-center h-12 px-6 bg-brand-400 text-brand-50 text-sm font-medium rounded-full hover:opacity-90 transition-all duration-200 tracking-[0.05em]"
                >
                    Solicitar nuevo enlace
                </a>
            </div>

            <!-- STATE: Form (new password) -->
            <div id="stateForm">

                <!-- Heading -->
                <div class="mb-8">
                    <p class="text-brand-300 text-xs font-medium tracking-[0.2em] uppercase mb-2">
                        Restablecer acceso
                    </p>
                    <h2 class="font-cormorant text-brand-400 text-4xl font-light mb-3">
                        Nueva contraseña
                    </h2>
                    <p class="text-brand-500 text-sm font-light leading-relaxed">
                        Ingresa y confirma tu nueva contraseña.<br />
                        Usa al menos 8 caracteres.
                    </p>
                </div>

                <form id="resetForm" novalidate class="space-y-4">

                    <!-- New password -->
                    <div>
                        <label for="password" class="block text-xs font-medium text-brand-700 tracking-[0.1em] uppercase mb-1.5">
                            Nueva contraseña
                        </label>
                        <div class="relative">
                            <input
                                type="password"
                                id="password"
                                name="password"
                                placeholder="••••••••"
                                autocomplete="new-password"
                                class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm text-brand-700 placeholder-gray-400 bg-white focus:outline-none focus:border-brand-300 focus:ring-2 focus:ring-brand-300/20 transition-all duration-200 pr-11"
                            />
                            <button type="button" id="togglePassword1" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-brand-400 transition-colors duration-200" aria-label="Mostrar contraseña">
                                <svg id="eyeIcon1" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </button>
                        </div>

                        <!-- Password strength bar -->
                        <div class="mt-2 space-y-1">
                            <div class="flex gap-1">
                                <div id="bar1" class="h-1 flex-1 rounded-full bg-gray-200 transition-colors duration-300"></div>
                                <div id="bar2" class="h-1 flex-1 rounded-full bg-gray-200 transition-colors duration-300"></div>
                                <div id="bar3" class="h-1 flex-1 rounded-full bg-gray-200 transition-colors duration-300"></div>
                                <div id="bar4" class="h-1 flex-1 rounded-full bg-gray-200 transition-colors duration-300"></div>
                            </div>
                            <p id="strengthLabel" class="text-xs text-gray-400"></p>
                        </div>

                        <p class="text-red-500 text-xs mt-1 hidden" id="passwordError">
                            La contraseña debe tener al menos 8 caracteres.
                        </p>
                    </div>

                    <!-- Confirm password -->
                    <div>
                        <label for="confirmPassword" class="block text-xs font-medium text-brand-700 tracking-[0.1em] uppercase mb-1.5">
                            Confirmar contraseña
                        </label>
                        <div class="relative">
                            <input
                                type="password"
                                id="confirmPassword"
                                name="confirmPassword"
                                placeholder="••••••••"
                                autocomplete="new-password"
                                class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm text-brand-700 placeholder-gray-400 bg-white focus:outline-none focus:border-brand-300 focus:ring-2 focus:ring-brand-300/20 transition-all duration-200 pr-11"
                            />
                            <button type="button" id="togglePassword2" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-brand-400 transition-colors duration-200" aria-label="Mostrar contraseña">
                                <svg id="eyeIcon2" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </button>
                        </div>
                        <p class="text-red-500 text-xs mt-1 hidden" id="confirmError">
                            Las contraseñas no coinciden.
                        </p>
                    </div>

                    <!-- Submit -->
                    <button
                        type="submit"
                        id="submitBtn"
                        class="w-full flex items-center justify-center h-12 px-6 bg-brand-400 text-brand-50 text-sm font-medium rounded-full hover:opacity-90 active:scale-[0.98] transition-all duration-200 mt-2 tracking-[0.05em]"
                    >
                        Guardar nueva contraseña
                    </button>

                </form>
            </div>

            <!-- STATE: Success -->
            <div id="stateSuccess" class="hidden text-center">

                <div class="flex items-center justify-center w-16 h-16 rounded-full bg-brand-400/10 mx-auto mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>

                <p class="text-brand-300 text-xs font-medium tracking-[0.2em] uppercase mb-2">
                    Listo
                </p>
                <h2 class="font-cormorant text-brand-400 text-4xl font-light mb-3">
                    Contraseña actualizada
                </h2>
                <p class="text-brand-500 text-sm font-light leading-relaxed mb-8">
                    Tu contraseña ha sido restablecida correctamente.<br />
                    Ya puedes iniciar sesión con tu nueva contraseña.
                </p>

                <a
                    href="/login"
                    class="w-full flex items-center justify-center h-12 px-6 bg-brand-400 text-brand-50 text-sm font-medium rounded-full hover:opacity-90 transition-all duration-200 tracking-[0.05em]"
                >
                    Iniciar sesión
                </a>

            </div>

        </div>
    </div>

</body>
</html>

<script>
    // — Toggle password visibility (field 1) —
    function makeToggle(btnId: string, inputId: string, iconId: string) {
        const btn = document.getElementById(btnId);
        const input = document.getElementById(inputId) as HTMLInputElement | null;
        const icon = document.getElementById(iconId);
        const eyeOpen = `<path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />`;
        const eyeClosed = `<path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />`;
        btn?.addEventListener('click', () => {
            if (!input || !icon) return;
            const isPassword = input.type === 'password';
            input.type = isPassword ? 'text' : 'password';
            icon.innerHTML = isPassword ? eyeClosed : eyeOpen;
        });
    }
    makeToggle('togglePassword1', 'password', 'eyeIcon1');
    makeToggle('togglePassword2', 'confirmPassword', 'eyeIcon2');

    // — Password strength indicator —
    const passwordInput = document.getElementById('password') as HTMLInputElement | null;
    const bars = [
        document.getElementById('bar1'),
        document.getElementById('bar2'),
        document.getElementById('bar3'),
        document.getElementById('bar4'),
    ];
    const strengthLabel = document.getElementById('strengthLabel');

    const strengthColors = ['bg-red-400', 'bg-orange-400', 'bg-yellow-400', 'bg-green-500'];
    const strengthTexts = ['Muy débil', 'Débil', 'Regular', 'Segura'];
    const strengthTextColors = ['text-red-400', 'text-orange-400', 'text-yellow-500', 'text-green-500'];

    function getStrength(val: string): number {
        let score = 0;
        if (val.length >= 8) score++;
        if (val.length >= 12) score++;
        if (/[A-Z]/.test(val) && /[0-9]/.test(val)) score++;
        if (/[^A-Za-z0-9]/.test(val)) score++;
        return Math.min(score, 4);
    }

    passwordInput?.addEventListener('input', () => {
        const val = passwordInput.value;
        const score = val ? getStrength(val) : 0;
        bars.forEach((bar, i) => {
            if (!bar) return;
            bar.className = 'h-1 flex-1 rounded-full transition-colors duration-300';
            bar.classList.add(i < score ? strengthColors[score - 1] : 'bg-gray-200');
        });
        if (strengthLabel) {
            if (!val) { strengthLabel.textContent = ''; return; }
            strengthLabel.textContent = strengthTexts[score - 1] ?? '';
            strengthLabel.className = `text-xs ${strengthTextColors[score - 1] ?? 'text-gray-400'}`;
        }
    });

    // — Form validation —
    const form = document.getElementById('resetForm');
    const confirmInput = document.getElementById('confirmPassword') as HTMLInputElement | null;
    const passwordError = document.getElementById('passwordError');
    const confirmError = document.getElementById('confirmError');
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
    const stateForm = document.getElementById('stateForm');
    const stateSuccess = document.getElementById('stateSuccess');

    passwordInput?.addEventListener('input', () => passwordError?.classList.add('hidden'));
    confirmInput?.addEventListener('input', () => confirmError?.classList.add('hidden'));

    form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const passVal = passwordInput?.value ?? '';
        const confirmVal = confirmInput?.value ?? '';
        let valid = true;

        if (passVal.length < 8) {
            passwordError?.classList.remove('hidden');
            valid = false;
        } else {
            passwordError?.classList.add('hidden');
        }

        if (passVal !== confirmVal) {
            confirmError?.classList.remove('hidden');
            valid = false;
        } else {
            confirmError?.classList.add('hidden');
        }

        if (!valid) return;

        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Guardando...';
        }

        // Placeholder: supabase.auth.updateUser({ password: passVal })
        setTimeout(() => {
            stateForm?.classList.add('hidden');
            stateSuccess?.classList.remove('hidden');
        }, 1200);
    });
</script>
