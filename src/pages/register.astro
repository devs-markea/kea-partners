---
import '../styles/global.css';
import { images } from '../assets/images';
import { Image } from 'astro:assets';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <title>Crear cuenta — KEA Partners</title>
</head>
<body class="min-h-screen bg-brand-50 font-jost flex">

    <!-- LEFT PANEL — Brand -->
    <div class="hidden lg:flex lg:w-1/2 bg-brand-400 relative flex-col justify-between p-12 overflow-hidden">

        <div class="absolute inset-0 opacity-5">
            <div class="absolute top-0 right-0 w-[600px] h-[600px] border border-brand-300 rounded-full translate-x-1/2 -translate-y-1/2"></div>
            <div class="absolute bottom-0 left-0 w-[400px] h-[400px] border border-brand-300 rounded-full -translate-x-1/2 translate-y-1/2"></div>
        </div>
        <div class="absolute bottom-24 right-0 w-[1px] h-48 bg-brand-300 opacity-30"></div>
        <div class="absolute top-1/3 left-12 w-24 h-[1px] bg-brand-300 opacity-20"></div>

        <!-- Logo -->
        <div class="relative z-10 flex items-center gap-4">
            <Image
                src={images.Logo}
                alt="KEA Partners"
                class="w-[90px] h-auto"
                quality={90}
                loading="eager"
            />
            <span class="text-brand-50 text-sm font-medium tracking-[0.15em] uppercase opacity-90">
                KEA Partners
            </span>
        </div>

        <!-- Center content -->
        <div class="relative z-10 flex-1 flex flex-col justify-center max-w-sm">
            <div class="w-8 h-[1px] bg-brand-300 mb-6"></div>
            <h1 class="font-cormorant text-brand-50 text-5xl font-light leading-tight mb-4">
                Tu acceso a<br />
                propiedades de<br />
                <em class="text-brand-300 not-italic">alto valor.</em>
            </h1>
            <p class="text-brand-50 text-sm font-light opacity-60 leading-relaxed">
                Crea tu cuenta y explora desarrollos exclusivos,<br />
                guarda tus favoritos y conecta con nuestros asesores.
            </p>
        </div>

        <div class="relative z-10">
            <p class="text-brand-50 text-xs opacity-30 tracking-[0.2em] uppercase">
                Luxury Real Estate · México
            </p>
        </div>

        <div class="absolute left-0 top-0 bottom-0 w-[3px] bg-gradient-to-b from-transparent via-brand-300 to-transparent opacity-40"></div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="flex-1 flex flex-col justify-center items-center px-6 py-12 lg:py-0">

        <!-- Mobile logo -->
        <div class="flex lg:hidden items-center gap-3 mb-10">
            <Image
                src={images.Logo}
                alt="KEA Partners"
                class="w-[72px] h-auto"
                quality={90}
                loading="eager"
            />
            <span class="text-brand-400 text-sm font-medium tracking-[0.15em] uppercase">
                KEA Partners
            </span>
        </div>

        <div class="w-full max-w-[400px]">

            <!-- STATE: Form -->
            <div id="stateForm">

                <!-- Heading -->
                <div class="mb-8">
                    <p class="text-brand-300 text-xs font-medium tracking-[0.2em] uppercase mb-2">
                        Nuevo acceso
                    </p>
                    <h2 class="font-cormorant text-brand-400 text-4xl font-light">
                        Crear cuenta
                    </h2>
                </div>

                <!-- Google OAuth -->
                <button
                    type="button"
                    id="googleBtn"
                    class="w-full flex items-center justify-center gap-3 px-4 py-3 border border-gray-200 rounded-xl bg-white text-brand-700 text-sm font-medium hover:border-brand-300 hover:shadow-sm transition-all duration-200 mb-6"
                    aria-label="Registrarse con Google"
                >
                    <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                    </svg>
                    Registrarse con Google
                </button>

                <!-- Divider -->
                <div class="flex items-center gap-3 mb-6">
                    <div class="flex-1 h-px bg-gray-200"></div>
                    <span class="text-brand-600 text-xs tracking-widest">O</span>
                    <div class="flex-1 h-px bg-gray-200"></div>
                </div>

                <!-- Form -->
                <form id="registerForm" novalidate class="space-y-4">

                    <!-- Full name -->
                    <div>
                        <label for="fullName" class="block text-xs font-medium text-brand-700 tracking-[0.1em] uppercase mb-1.5">
                            Nombre completo
                        </label>
                        <input
                            type="text"
                            id="fullName"
                            name="fullName"
                            placeholder="Tu nombre"
                            autocomplete="name"
                            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm text-brand-700 placeholder-gray-400 bg-white focus:outline-none focus:border-brand-300 focus:ring-2 focus:ring-brand-300/20 transition-all duration-200"
                        />
                        <p class="text-red-500 text-xs mt-1 hidden" id="nameError">
                            El nombre es obligatorio.
                        </p>
                    </div>

                    <!-- Email -->
                    <div>
                        <label for="email" class="block text-xs font-medium text-brand-700 tracking-[0.1em] uppercase mb-1.5">
                            Correo electrónico
                        </label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="tu@correo.com"
                            autocomplete="email"
                            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm text-brand-700 placeholder-gray-400 bg-white focus:outline-none focus:border-brand-300 focus:ring-2 focus:ring-brand-300/20 transition-all duration-200"
                        />
                        <p class="text-red-500 text-xs mt-1 hidden" id="emailError">
                            Ingresa un correo electrónico válido.
                        </p>
                    </div>

                    <!-- Password -->
                    <div>
                        <label for="password" class="block text-xs font-medium text-brand-700 tracking-[0.1em] uppercase mb-1.5">
                            Contraseña
                        </label>
                        <div class="relative">
                            <input
                                type="password"
                                id="password"
                                name="password"
                                placeholder="••••••••"
                                autocomplete="new-password"
                                class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm text-brand-700 placeholder-gray-400 bg-white focus:outline-none focus:border-brand-300 focus:ring-2 focus:ring-brand-300/20 transition-all duration-200 pr-11"
                            />
                            <button type="button" id="togglePassword1" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-brand-400 transition-colors duration-200" aria-label="Mostrar contraseña">
                                <svg id="eyeIcon1" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </button>
                        </div>

                        <!-- Strength bar -->
                        <div class="mt-2 space-y-1">
                            <div class="flex gap-1">
                                <div id="bar1" class="h-1 flex-1 rounded-full bg-gray-200 transition-colors duration-300"></div>
                                <div id="bar2" class="h-1 flex-1 rounded-full bg-gray-200 transition-colors duration-300"></div>
                                <div id="bar3" class="h-1 flex-1 rounded-full bg-gray-200 transition-colors duration-300"></div>
                                <div id="bar4" class="h-1 flex-1 rounded-full bg-gray-200 transition-colors duration-300"></div>
                            </div>
                            <p id="strengthLabel" class="text-xs text-gray-400"></p>
                        </div>

                        <p class="text-red-500 text-xs mt-1 hidden" id="passwordError">
                            Mínimo 8 caracteres con mayúscula, minúscula, número y símbolo.
                        </p>
                    </div>

                    <!-- Confirm password -->
                    <div>
                        <label for="confirmPassword" class="block text-xs font-medium text-brand-700 tracking-[0.1em] uppercase mb-1.5">
                            Confirmar contraseña
                        </label>
                        <div class="relative">
                            <input
                                type="password"
                                id="confirmPassword"
                                name="confirmPassword"
                                placeholder="••••••••"
                                autocomplete="new-password"
                                class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm text-brand-700 placeholder-gray-400 bg-white focus:outline-none focus:border-brand-300 focus:ring-2 focus:ring-brand-300/20 transition-all duration-200 pr-11"
                            />
                            <button type="button" id="togglePassword2" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-brand-400 transition-colors duration-200" aria-label="Mostrar contraseña">
                                <svg id="eyeIcon2" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </button>
                        </div>
                        <p class="text-red-500 text-xs mt-1 hidden" id="confirmError">
                            Las contraseñas no coinciden.
                        </p>
                    </div>

                    <!-- Terms -->
                    <div class="flex items-start gap-2 pt-1">
                        <input
                            type="checkbox"
                            id="terms"
                            name="terms"
                            class="w-4 h-4 mt-0.5 rounded border-gray-300 accent-brand-400 cursor-pointer flex-shrink-0"
                        />
                        <label for="terms" class="text-xs text-brand-500 cursor-pointer leading-relaxed">
                            Acepto los
                            <a href="#" class="text-brand-300 hover:underline">Términos de servicio</a>
                            y la
                            <a href="#" class="text-brand-300 hover:underline">Política de privacidad</a>
                        </label>
                    </div>
                    <p class="text-red-500 text-xs hidden" id="termsError">
                        Debes aceptar los términos para continuar.
                    </p>

                    <!-- Submit -->
                    <button
                        type="submit"
                        id="submitBtn"
                        class="w-full flex items-center justify-center h-12 px-6 bg-brand-400 text-brand-50 text-sm font-medium rounded-full hover:opacity-90 active:scale-[0.98] transition-all duration-200 mt-2 tracking-[0.05em]"
                    >
                        Crear cuenta
                    </button>

                    <!-- Generic error -->
                    <p id="formError" class="hidden text-red-500 text-xs text-center mt-1">
                        Ocurrió un error. Inténtalo de nuevo.
                    </p>

                </form>

                <!-- Login link -->
                <p class="text-center text-xs text-brand-500 mt-8">
                    ¿Ya tienes cuenta?
                    <a href="/login" class="text-brand-300 font-medium hover:underline transition-colors duration-200">
                        Inicia sesión
                    </a>
                </p>

            </div>

            <!-- STATE: Email confirmation pending -->
            <div id="stateConfirm" class="hidden text-center">

                <div class="flex items-center justify-center w-16 h-16 rounded-full bg-brand-400/10 mx-auto mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                    </svg>
                </div>

                <p class="text-brand-300 text-xs font-medium tracking-[0.2em] uppercase mb-2">
                    Casi listo
                </p>
                <h2 class="font-cormorant text-brand-400 text-4xl font-light mb-3">
                    Confirma tu correo
                </h2>
                <p class="text-brand-500 text-sm font-light leading-relaxed mb-2">
                    Enviamos un enlace de confirmación a
                </p>
                <p id="confirmedEmail" class="text-brand-400 text-sm font-medium mb-4">
                    —
                </p>
                <p class="text-brand-500 text-xs leading-relaxed mb-8">
                    Haz clic en el enlace del correo para activar tu cuenta.<br />
                    Si no lo ves, revisa tu carpeta de <span class="font-medium text-brand-700">spam</span>.
                </p>

                <!-- Resend -->
                <button
                    id="resendBtn"
                    type="button"
                    class="w-full flex items-center justify-center h-12 px-6 border border-brand-400 text-brand-400 text-sm font-medium rounded-full hover:bg-brand-400 hover:text-brand-50 transition-all duration-200 mb-6"
                >
                    Reenviar correo de confirmación
                </button>

                <p class="text-center text-xs text-brand-500">
                    <a href="/login" class="inline-flex items-center gap-1.5 text-brand-300 font-medium hover:underline transition-colors duration-200">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        Volver a iniciar sesión
                    </a>
                </p>

            </div>

        </div>
    </div>

</body>
</html>

<script>
    import { createBrowserClient } from '@supabase/ssr';

    const supabase = createBrowserClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY
    );

    // ── Toggle helpers ────────────────────────────────────────────────────────
    const eyeOpen   = `<path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />`;
    const eyeClosed = `<path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />`;

    function makeToggle(btnId: string, inputId: string, iconId: string) {
        const btn   = document.getElementById(btnId);
        const input = document.getElementById(inputId) as HTMLInputElement | null;
        const icon  = document.getElementById(iconId);
        btn?.addEventListener('click', () => {
            if (!input || !icon) return;
            const isPass = input.type === 'password';
            input.type = isPass ? 'text' : 'password';
            icon.innerHTML = isPass ? eyeClosed : eyeOpen;
        });
    }
    makeToggle('togglePassword1', 'password', 'eyeIcon1');
    makeToggle('togglePassword2', 'confirmPassword', 'eyeIcon2');

    // ── Indicador de fortaleza ────────────────────────────────────────────────
    // Refleja la configuración de Supabase: min 8 chars + lower + upper + digit + symbol
    const passwordInput = document.getElementById('password') as HTMLInputElement | null;
    const bars          = ['bar1','bar2','bar3','bar4'].map(id => document.getElementById(id));
    const strengthLabel = document.getElementById('strengthLabel');
    const strengthColors     = ['bg-red-400','bg-orange-400','bg-yellow-400','bg-green-500'];
    const strengthTexts      = ['Muy débil','Débil','Regular','Segura'];
    const strengthTextColors = ['text-red-400','text-orange-400','text-yellow-500','text-green-500'];

    function getStrength(val: string): number {
        let s = 0;
        if (val.length >= 8)              s++;
        if (/[a-z]/.test(val))            s++;
        if (/[A-Z]/.test(val))            s++;
        if (/[0-9]/.test(val))            s++;
        if (/[^A-Za-z0-9]/.test(val))     s++;
        // Clamp a 4 niveles (5 criterios → 4 barras)
        return Math.min(Math.floor(s * 4 / 5), 4);
    }

    function meetsSupabasePolicy(val: string): boolean {
        return (
            val.length >= 8        &&
            /[a-z]/.test(val)      &&
            /[A-Z]/.test(val)      &&
            /[0-9]/.test(val)      &&
            /[^A-Za-z0-9]/.test(val)
        );
    }

    passwordInput?.addEventListener('input', () => {
        const val   = passwordInput.value;
        const score = val ? getStrength(val) : 0;
        bars.forEach((bar, i) => {
            if (!bar) return;
            bar.className = 'h-1 flex-1 rounded-full transition-colors duration-300';
            bar.classList.add(i < score ? strengthColors[score - 1] : 'bg-gray-200');
        });
        if (strengthLabel) {
            strengthLabel.textContent = val ? (strengthTexts[score - 1] ?? '') : '';
            strengthLabel.className   = `text-xs ${val ? (strengthTextColors[score - 1] ?? '') : 'text-gray-400'}`;
        }
    });

    // ── Google OAuth ──────────────────────────────────────────────────────────
    document.getElementById('googleBtn')?.addEventListener('click', async () => {
        await supabase.auth.signInWithOAuth({
            provider: 'google',
            options: { redirectTo: `${window.location.origin}/auth/callback` },
        });
    });

    // ── Formulario ────────────────────────────────────────────────────────────
    const form      = document.getElementById('registerForm');
    const nameInput = document.getElementById('fullName')         as HTMLInputElement | null;
    const emailInput= document.getElementById('email')            as HTMLInputElement | null;
    const confirmInput = document.getElementById('confirmPassword') as HTMLInputElement | null;
    const termsInput= document.getElementById('terms')            as HTMLInputElement | null;

    const nameError    = document.getElementById('nameError');
    const emailError   = document.getElementById('emailError');
    const passwordError= document.getElementById('passwordError');
    const confirmError = document.getElementById('confirmError');
    const termsError   = document.getElementById('termsError');
    const formError    = document.getElementById('formError');
    const submitBtn    = document.getElementById('submitBtn') as HTMLButtonElement | null;
    const stateForm    = document.getElementById('stateForm');
    const stateConfirm = document.getElementById('stateConfirm');
    const confirmedEmailEl = document.getElementById('confirmedEmail');
    const resendBtn    = document.getElementById('resendBtn') as HTMLButtonElement | null;

    nameInput?.addEventListener('input',     () => nameError?.classList.add('hidden'));
    emailInput?.addEventListener('input',    () => emailError?.classList.add('hidden'));
    passwordInput?.addEventListener('input', () => passwordError?.classList.add('hidden'));
    confirmInput?.addEventListener('input',  () => confirmError?.classList.add('hidden'));
    termsInput?.addEventListener('change',   () => termsError?.classList.add('hidden'));

    async function handleSubmit(e: Event) {
        e.preventDefault();

        const nameVal    = nameInput?.value.trim()  ?? '';
        const emailVal   = emailInput?.value.trim() ?? '';
        const passVal    = passwordInput?.value      ?? '';
        const confirmVal = confirmInput?.value        ?? '';
        const termsVal   = termsInput?.checked        ?? false;
        let valid = true;

        if (!nameVal)
            { nameError?.classList.remove('hidden'); valid = false; }
        if (!emailVal || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal))
            { emailError?.classList.remove('hidden'); valid = false; }
        if (!meetsSupabasePolicy(passVal))
            { passwordError?.classList.remove('hidden'); valid = false; }
        if (passVal !== confirmVal)
            { confirmError?.classList.remove('hidden'); valid = false; }
        if (!termsVal)
            { termsError?.classList.remove('hidden'); valid = false; }

        if (!valid) return;

        formError?.classList.add('hidden');
        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Creando cuenta...'; }

        try {
            const res  = await fetch('/api/auth/register', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({ email: emailVal, password: passVal, fullName: nameVal, termsAccepted: true }),
            });
            const data = await res.json();

            if (res.ok && data.success) {
                if (confirmedEmailEl) confirmedEmailEl.textContent = emailVal;
                if (data.needsConfirmation) {
                    stateForm?.classList.add('hidden');
                    stateConfirm?.classList.remove('hidden');
                } else {
                    window.location.href = '/';
                }
            } else {
                if (formError) formError.textContent = data.error ?? 'Error al crear la cuenta.';
                formError?.classList.remove('hidden');
            }
        } catch {
            if (formError) formError.textContent = 'Error de conexión. Inténtalo de nuevo.';
            formError?.classList.remove('hidden');
        } finally {
            if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Crear cuenta'; }
        }
    }

    form?.addEventListener('submit', handleSubmit);

    // ── Reenviar email de confirmación ────────────────────────────────────────
    async function handleResend() {
        if (!resendBtn) return;
        resendBtn.disabled = true;
        resendBtn.textContent = 'Reenviando...';

        const emailVal = confirmedEmailEl?.textContent?.trim() ?? '';
        try {
            await supabase.auth.resend({ type: 'signup', email: emailVal });
        } catch { /* silencioso */ }

        resendBtn.textContent = 'Correo reenviado';
        setTimeout(() => {
            if (resendBtn) { resendBtn.disabled = false; resendBtn.textContent = 'Reenviar correo de confirmación'; }
        }, 3000);
    }

    resendBtn?.addEventListener('click', handleResend);
</script>
