---
import '../styles/global.css';
import { images } from '../assets/images';
import { Image } from 'astro:assets';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <title>Recuperar contraseña — KEA Partners</title>
</head>
<body class="min-h-screen bg-brand-50 font-jost flex">

    <!-- LEFT PANEL — Brand -->
    <div class="hidden lg:flex lg:w-1/2 bg-brand-400 relative flex-col justify-between p-12 overflow-hidden">

        <!-- Decorative background elements -->
        <div class="absolute inset-0 opacity-5">
            <div class="absolute top-0 right-0 w-[600px] h-[600px] border border-brand-300 rounded-full translate-x-1/2 -translate-y-1/2"></div>
            <div class="absolute bottom-0 left-0 w-[400px] h-[400px] border border-brand-300 rounded-full -translate-x-1/2 translate-y-1/2"></div>
        </div>
        <div class="absolute bottom-24 right-0 w-[1px] h-48 bg-brand-300 opacity-30"></div>
        <div class="absolute top-1/3 left-12 w-24 h-[1px] bg-brand-300 opacity-20"></div>

        <!-- Logo -->
        <div class="relative z-10 flex items-center gap-4">
            <Image
                src={images.Logo}
                alt="KEA Partners"
                class="w-[90px] h-auto"
                quality={90}
                loading="eager"
            />
            <span class="text-brand-50 text-sm font-medium tracking-[0.15em] uppercase opacity-90">
                KEA Partners
            </span>
        </div>

        <!-- Center content -->
        <div class="relative z-10 flex-1 flex flex-col justify-center max-w-sm">
            <div class="w-8 h-[1px] bg-brand-300 mb-6"></div>
            <h1 class="font-cormorant text-brand-50 text-5xl font-light leading-tight mb-4">
                Sin acceso<br />
                a tu cuenta,<br />
                <em class="text-brand-300 not-italic">te ayudamos.</em>
            </h1>
            <p class="text-brand-50 text-sm font-light opacity-60 leading-relaxed">
                Te enviaremos un enlace seguro a tu correo<br />
                para que puedas restablecer tu contraseña.
            </p>
        </div>

        <!-- Bottom tagline -->
        <div class="relative z-10">
            <p class="text-brand-50 text-xs opacity-30 tracking-[0.2em] uppercase">
                Luxury Real Estate · México
            </p>
        </div>

        <!-- Golden accent line -->
        <div class="absolute left-0 top-0 bottom-0 w-[3px] bg-gradient-to-b from-transparent via-brand-300 to-transparent opacity-40"></div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="flex-1 flex flex-col justify-center items-center px-6 py-12 lg:py-0">

        <!-- Mobile logo -->
        <div class="flex lg:hidden items-center gap-3 mb-10">
            <Image
                src={images.Logo}
                alt="KEA Partners"
                class="w-[72px] h-auto"
                quality={90}
                loading="eager"
            />
            <span class="text-brand-400 text-sm font-medium tracking-[0.15em] uppercase">
                KEA Partners
            </span>
        </div>

        <div class="w-full max-w-[400px]">

            <!-- STATE: Default (form) -->
            <div id="stateForm">

                <!-- Heading -->
                <div class="mb-8">
                    <p class="text-brand-300 text-xs font-medium tracking-[0.2em] uppercase mb-2">
                        Recuperar acceso
                    </p>
                    <h2 class="font-cormorant text-brand-400 text-4xl font-light mb-3">
                        ¿Olvidaste tu contraseña?
                    </h2>
                    <p class="text-brand-500 text-sm font-light leading-relaxed">
                        Ingresa el correo asociado a tu cuenta y te enviaremos un enlace para restablecerla.
                    </p>
                </div>

                <form id="forgotForm" novalidate class="space-y-4">

                    <!-- Email -->
                    <div>
                        <label for="email" class="block text-xs font-medium text-brand-700 tracking-[0.1em] uppercase mb-1.5">
                            Correo electrónico
                        </label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="tu@correo.com"
                            autocomplete="email"
                            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm text-brand-700 placeholder-gray-400 bg-white focus:outline-none focus:border-brand-300 focus:ring-2 focus:ring-brand-300/20 transition-all duration-200"
                        />
                        <p class="text-red-500 text-xs mt-1 hidden" id="emailError">
                            Ingresa un correo electrónico válido.
                        </p>
                    </div>

                    <!-- Submit -->
                    <button
                        type="submit"
                        id="submitBtn"
                        class="w-full flex items-center justify-center h-12 px-6 bg-brand-400 text-brand-50 text-sm font-medium rounded-full hover:opacity-90 active:scale-[0.98] transition-all duration-200 mt-2 tracking-[0.05em]"
                    >
                        Enviar enlace de recuperación
                    </button>

                </form>

                <!-- Back to login -->
                <p class="text-center text-xs text-brand-500 mt-8">
                    <a href="/login" class="inline-flex items-center gap-1.5 text-brand-300 font-medium hover:underline transition-colors duration-200">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        Volver a iniciar sesión
                    </a>
                </p>

            </div>

            <!-- STATE: Email sent (success) -->
            <div id="stateSent" class="hidden text-center">

                <!-- Icon -->
                <div class="flex items-center justify-center w-16 h-16 rounded-full bg-brand-400/10 mx-auto mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                    </svg>
                </div>

                <p class="text-brand-300 text-xs font-medium tracking-[0.2em] uppercase mb-2">
                    Correo enviado
                </p>
                <h2 class="font-cormorant text-brand-400 text-4xl font-light mb-3">
                    Revisa tu bandeja
                </h2>
                <p class="text-brand-500 text-sm font-light leading-relaxed mb-2">
                    Enviamos un enlace de recuperación a
                </p>
                <p id="sentEmail" class="text-brand-400 text-sm font-medium mb-6">
                    —
                </p>
                <p class="text-brand-500 text-xs leading-relaxed mb-8">
                    Si no ves el correo, revisa tu carpeta de spam.<br />
                    El enlace expira en <span class="font-medium text-brand-700">60 minutos</span>.
                </p>

                <!-- Resend -->
                <button
                    id="resendBtn"
                    type="button"
                    class="w-full flex items-center justify-center h-12 px-6 border border-brand-400 text-brand-400 text-sm font-medium rounded-full hover:bg-brand-400 hover:text-brand-50 transition-all duration-200 mb-6"
                >
                    Reenviar correo
                </button>

                <p class="text-center text-xs text-brand-500">
                    <a href="/login" class="inline-flex items-center gap-1.5 text-brand-300 font-medium hover:underline transition-colors duration-200">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        Volver a iniciar sesión
                    </a>
                </p>

            </div>

        </div>
    </div>

</body>
</html>

<script>
    const form       = document.getElementById('forgotForm');
    const emailInput = document.getElementById('email')     as HTMLInputElement  | null;
    const emailError = document.getElementById('emailError');
    const submitBtn  = document.getElementById('submitBtn') as HTMLButtonElement | null;
    const stateForm  = document.getElementById('stateForm');
    const stateSent  = document.getElementById('stateSent');
    const sentEmailEl= document.getElementById('sentEmail');
    const resendBtn  = document.getElementById('resendBtn') as HTMLButtonElement | null;

    emailInput?.addEventListener('input', () => emailError?.classList.add('hidden'));

    async function handleSubmit(e: Event) {
        e.preventDefault();
        const emailVal = emailInput?.value.trim() ?? '';

        if (!emailVal || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) {
            emailError?.classList.remove('hidden');
            return;
        }
        emailError?.classList.add('hidden');
        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Enviando...'; }

        try {
            const res  = await fetch('/api/auth/forgot-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: emailVal }),
            });
            const data = await res.json();

            if (res.status === 429) {
                if (emailError) emailError.textContent = data.error ?? 'Demasiados intentos.';
                emailError?.classList.remove('hidden');
                return;
            }

            if (sentEmailEl) sentEmailEl.textContent = emailVal;
            stateForm?.classList.add('hidden');
            stateSent?.classList.remove('hidden');
        } catch {
            if (emailError) emailError.textContent = 'Error de conexión. Inténtalo de nuevo.';
            emailError?.classList.remove('hidden');
        } finally {
            if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Enviar enlace de recuperación'; }
        }
    }

    form?.addEventListener('submit', handleSubmit);

    async function handleResend() {
        if (!resendBtn) return;
        resendBtn.disabled = true;
        resendBtn.textContent = 'Reenviando...';

        const emailVal = sentEmailEl?.textContent?.trim() ?? '';
        try {
            await fetch('/api/auth/forgot-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: emailVal }),
            });
        } catch { /* silencioso */ }

        resendBtn.textContent = 'Correo reenviado';
        setTimeout(() => {
            if (resendBtn) { resendBtn.disabled = false; resendBtn.textContent = 'Reenviar correo'; }
        }, 3000);
    }

    resendBtn?.addEventListener('click', handleResend);
</script>
