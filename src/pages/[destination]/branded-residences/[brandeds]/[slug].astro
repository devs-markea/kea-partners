---
import MainLayout from "../../../../layouts/MainLayout.astro";
import HeroBannerSection from "../../../../components/sections/HeroBannerSection.astro";
import ResourceArticleSection from "../../../../components/sections/article/ResourceArticleSection.astro";
import DestinationData from "../../../../data/i18n/es/branded-residences.json";
import Common from "../../../../data/i18n/es/common.json";
import DevelopmentsData from "../../../../data/i18n/es/developments.json";
import Article from "../../../../data/i18n/es/article.json";
import HideAttributes from "../../../../data/i18n/es/hide-attributes-development.json";

import { getDevelopmentBySlug } from "@/lib/supabase/resilient";

const { destination, brandeds, slug } = Astro.params;
const lang = "es";
const CATEGORY = "branded-residences";

// ── Desarrollo desde Supabase (info + destino + grupo + artículos) ──────────
// Igual que high-end/commercial, pero el desarrollo pertenece a un GRUPO
// (branded residence): se valida y se trae embebido para el breadcrumb.
const apiDev = await getDevelopmentBySlug(slug!, lang, {
    destination: true,
    group: true,
    articles: true,
}).catch((error) => {
    console.error(`[branded/${slug}] No se pudo cargar el desarrollo:`, error);
    return null;
});

// Válido solo si es branded, de este destino y de este grupo (URL canónica).
const apiDevValid =
    apiDev &&
    apiDev.category === CATEGORY &&
    apiDev.destination?.slug === destination &&
    apiDev.group?.slug === brandeds
        ? apiDev
        : null;

// Respaldo legacy: mismo criterio (branded + destino + grupo + slug).
const legacyDev = DevelopmentsData.listDevelopments.find(
    (d) => d.developmentCategory === CATEGORY &&
           d.developmentDestination === destination &&
           d.developmentGroup === brandeds &&
           d.developmentLink === slug,
);

// Si el desarrollo existe en la API pero no está publicado (draft/inactive),
// se oculta: redirige al home (la API invalida el respaldo legacy).
if (apiDevValid && apiDevValid.status !== "published") {
    return Astro.redirect("/");
}

if (!apiDevValid && !legacyDev) {
    return Astro.redirect("/404");
}

const heroData = {
    title:     apiDevValid?.name ?? legacyDev?.developmentName ?? "",
    bannerUrl: apiDevValid?.bannerUrl ?? null,
    bannerKey: legacyDev?.developmentBanner ?? null,
    alt:       apiDevValid?.alt ?? legacyDev?.developmentAlt ?? apiDevValid?.name ?? "",
};

// ── Artículos del desarrollo ────────────────────────────────────────────────
let articleItems: { title: string; url: string }[] = [];
if (apiDevValid) {
    // API: solo artículos con `is_visible = true`; los `false` se ignoran.
    articleItems = (apiDevValid.articles ?? [])
        .filter((a) => a.isVisible)
        .map((a) => ({ title: a.title, url: a.url }));
} else if (legacyDev) {
    const modules = import.meta.glob("../../../../data/i18n/es/*.json");
    const loader = modules[`../../../../data/i18n/es/${legacyDev.developmentContent}.json`];
    const Data: any = loader ? await loader() : {};
    const hiddenAttrs = HideAttributes.developments.find(
        (d) => d.developmentContent === legacyDev.developmentContent,
    )?.developmentAttribututes?.map((a) => a.attribute) ?? [];
    articleItems = (Data.article ?? []).filter(
        (item: any) => !hiddenAttrs.includes(item.title),
    );
}
const article = { article: articleItems };

// Nombre del grupo (branded residence) para el breadcrumb: API primero, luego
// el JSON legacy de grupos, y por último el slug de la URL.
const legacyGroupName = DestinationData.listBrandedResidents.find(
    (item) => item.brandedResidentUrl === brandeds,
)?.brandedResidentName;
const nameGroup = apiDevValid?.group?.name ?? legacyGroupName ?? brandeds;

const destinationName =
    apiDevValid?.destination?.title ??
    destination?.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());

const breadcrumbItems = [
    { name: "Inicio", url: "/" },
    { name: destinationName },
    { name: "Branded Residences" },
    { name: nameGroup },
    { name: heroData.title },
];

const devLink = legacyDev?.developmentPagelink || undefined;
---

<MainLayout title="KEA Partners" lang="es" t={Common}>
  <HeroBannerSection t={heroData} lang="es" link={devLink} />

  <ResourceArticleSection
    breadcrumbItems={breadcrumbItems}
    article={article}
    tArticle={Article}
    lang="es"
  />
</MainLayout>
