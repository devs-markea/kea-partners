---
import MainLayout from "../../../layouts/MainLayout.astro";
import HeroBannerSection from "../../../components/sections/HeroBannerSection.astro";
import ResourceArticleSection from "../../../components/sections/article/ResourceArticleSection.astro";

import Common from '../../../data/i18n/es/common.json';
import DevelopmentsData from '../../../data/i18n/es/developments.json';
import Article from "../../../data/i18n/es/article.json";

const { destination, slug } = Astro.params;

const dev = DevelopmentsData.listDevelopments.find(
    d => d.developmentCategory === "high-end-resort" &&
         d.developmentDestination === destination &&
         d.developmentLink === slug
);

if (!dev) {
    return Astro.redirect('/404');
}

const heroData = {
    title: dev.developmentName,
    bannerKey: dev.developmentBanner,
    alt: dev.developmentAlt
};

const modules = import.meta.glob('../../../data/i18n/es/*.json');
const Data = await modules[
    `../../../data/i18n/es/${dev.developmentContent}.json`
    ]();

const breadcrumbItems = [
    { name: 'Inicio', url: '/' },
    { name: dev.developmentDestination
            ?.replace(/-/g, " ")
            .replace(/\b\w/g, c => c.toUpperCase()) },
    { name: 'High-End and Resort Living' },
    { name: dev.developmentName }
];
const devLink = dev.developmentPagelink;

---
<MainLayout title="KEA Partners"lang="es" t={Common}>
    <HeroBannerSection t={heroData} lang="es" link={devLink}/>

    <ResourceArticleSection
            breadcrumbItems={breadcrumbItems}
            article={Data}
            tArticle={Article}
            lang="es"
    />
</MainLayout>
